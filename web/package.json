{
  "name": "lumiritin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:airfields": "tsx prisma/seed-airfields.ts",
    "job:verify": "tsx --env-file=../.env jobs/nightly-verify.ts",
    "job:reminders": "tsx --env-file=../.env jobs/expiry-reminders.ts",
    "job:cascade": "tsx --env-file=../.env jobs/cascade-tick.ts",
    "job:calendar": "tsx --env-file=../.env jobs/calendar-sync.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "framer-motion": "^13.5.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.28",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
