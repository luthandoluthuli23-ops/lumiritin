# Database
DATABASE_URL=postgresql://lumiritin:lumiritin@localhost:5432/lumiritin

# Session signing key for auth cookies. Required, 32+ chars. Generate one per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Public WhatsApp concierge number in E.164 (e.g. +27821234567). The footer link is hidden when blank.
NEXT_PUBLIC_WHATSAPP_CONCIERGE_E164=

# SACAA portal (placeholders - confirm against the real portal)
SACAA_PORTAL_URL=
SACAA_QUERY_PARAM=licenceNumber
SACAA_METHOD=GET
SACAA_MIN_INTERVAL_SECONDS=5
SACAA_USER_AGENT=Lumiritin-Verifier/0.1 (contact: ops@example.co.za)

# How the web jobs invoke the Python verifier
VERIFIER_CMD=python -m lumiritin_verifier
VERIFIER_CWD=../verifier
VERIFY_DELAY_MS=5000

# WhatsApp Cloud API (leave blank to log messages to console instead)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_EXPIRY=credential_expiry_reminder
# Approved template for crew confirm-pings. Body params in order: name, route, window, link, minutes.
WHATSAPP_TEMPLATE_CREW_PING=crew_request_ping

# Public base URL used in the one-tap links sent to pilots AND to build the OAuth redirect URI below. Set it in production.
APP_BASE_URL=http://localhost:3000
WHATSAPP_TEMPLATE_LANG=en

# MyFlightbook logbook connection (OAuth2 confidential client, registered at the MyFlightbook developer page).
# Only the id and secret are required; the endpoints below are the defaults and only need setting to use a staging server.
# The callback registered for the client must be exactly:  <APP_BASE_URL>/api/logbook/connect/myflightbook/callback  (https).
MYFLIGHTBOOK_CLIENT_ID=
MYFLIGHTBOOK_CLIENT_SECRET=
# MYFLIGHTBOOK_AUTH_URL=https://myflightbook.com/logbook/mvc/oAuth/Authorize
# MYFLIGHTBOOK_TOKEN_URL=https://myflightbook.com/logbook/mvc/oAuth/OAuthToken
# MYFLIGHTBOOK_API_URL=https://myflightbook.com/logbook/mvc/oAuth/OAuthResource
# Space-separated. The importer only reads flights, so "readflight" is all it needs (and the default).
# MYFLIGHTBOOK_SCOPE=readflight
# Set to 1 to log which landing/date fields the first real MyFlightbook flight contains (no comments, route or tail).
# MYFLIGHTBOOK_DEBUG=1

# Lumi (AI document reading for logbook PDFs/photos and licence/AOC verification). Without a key those features are hidden.
ANTHROPIC_API_KEY=
# LUMI_MODEL=claude-opus-5-5

# Secret for the Vercel Cron call to /api/cron/expiry-reminders (the route returns 503 if unset).
CRON_SECRET=
