# Database
DATABASE_URL=postgresql://lumiritin:lumiritin@localhost:5432/lumiritin

# Session signing key for auth cookies. Required, 32+ chars. Generate one per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Custom charter (/charter, the quote API and the "Charter" nav item). Off unless "true"; routes 404 while off.
# Baked in at build time (next.config.mjs), so redeploy after changing it.
CHARTER_PUBLIC=false
# ICAO codes charter is actually offered at, comma separated (e.g. FALA,FACT). Every other airfield shows "Coming soon".
CHARTER_SERVED_AIRFIELDS=
# Public contact email shown in the footer and on /about. Defaults to hello@lumiritin.co.za; set only to override.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public WhatsApp/phone number in E.164 (e.g. +27821234567). Shown as the placeholder [PHONE] until set.
NEXT_PUBLIC_WHATSAPP_CONCIERGE_E164=

# SACAA portal (placeholders - confirm against the real portal)
SACAA_PORTAL_URL=
SACAA_QUERY_PARAM=licenceNumber
SACAA_METHOD=GET
SACAA_MIN_INTERVAL_SECONDS=5
SACAA_USER_AGENT=Lumiritin-Verifier/0.1 (contact: ops@example.co.za)

# How the web jobs invoke the Python verifier
VERIFIER_CMD=python -m lumiritin_verifier
VERIFIER_CWD=../verifier
VERIFY_DELAY_MS=5000

# Transactional email via Resend (welcome email on sign-up, charter confirmations, expiry reminders). Without a key emails are only logged.
# With the default sender (onboarding@resend.dev) Resend ONLY delivers to the email on your own Resend account, so real users get
# nothing until you verify a domain at resend.com/domains and set EMAIL_FROM to an address on it, e.g. "Lumiritin <hello@lumiritin.co.za>".
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp Cloud API (leave blank to log messages to console instead)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Expiry reminders 60, 30 and 7 days before. Body params in order: name, item, expiry date, days left.
WHATSAPP_TEMPLATE_EXPIRY=credential_expiry_reminder
# Approved template for crew confirm-pings. Body params in order: name, route, window, link, minutes.
WHATSAPP_TEMPLATE_CREW_PING=crew_request_ping
# Approved template for verification state changes. Body params in order: name, new state, detail
# (e.g. "Verified against SACAA records on 10 Nov 2026"). Needs Meta approval before it can send.
WHATSAPP_TEMPLATE_STATE_CHANGE=verification_state_change

# Public base URL used in the one-tap links sent to pilots AND to build the OAuth redirect URI below. Set it in production.
APP_BASE_URL=http://localhost:3000
WHATSAPP_TEMPLATE_LANG=en

# MyFlightbook logbook connection (OAuth2 confidential client, registered at the MyFlightbook developer page).
# Only the id and secret are required; the endpoints below are the defaults and only need setting to use a staging server.
# The callback registered for the client must be exactly:  <APP_BASE_URL>/api/logbook/connect/myflightbook/callback  (https).
MYFLIGHTBOOK_CLIENT_ID=
MYFLIGHTBOOK_CLIENT_SECRET=
# MYFLIGHTBOOK_AUTH_URL=https://myflightbook.com/logbook/mvc/oAuth/Authorize
# MYFLIGHTBOOK_TOKEN_URL=https://myflightbook.com/logbook/mvc/oAuth/OAuthToken
# MYFLIGHTBOOK_API_URL=https://myflightbook.com/logbook/mvc/oAuth/OAuthResource
# Space-separated. The importer only reads flights, so "readflight" is all it needs (and the default).
# MYFLIGHTBOOK_SCOPE=readflight
# Set to 1 to log which landing/date fields the first real MyFlightbook flight contains (no comments, route or tail).
# MYFLIGHTBOOK_DEBUG=1

# Lumi (AI document reading for logbook PDFs/photos and licence/AOC verification). Without a key those features are hidden.
ANTHROPIC_API_KEY=
# LUMI_MODEL=claude-opus-5-5

# "Ask Lumi" site chat assistant (floating chat button): uses the same ANTHROPIC_API_KEY and is hidden without it.
# It defaults to the smallest/cheapest model tier; override only if you need to.
# LUMI_CHAT_MODEL=claude-haiku-5-5

# Pilot-triggered verification (Task 4).
# 32 random bytes (base64) used ONLY to encrypt uploaded licence/medical photos. Required for uploads; no fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  Never change it once
# documents exist (they could no longer be opened) and never reuse SESSION_SECRET.
DOCUMENT_ENCRYPTION_KEY=
# Comma-separated emails of signed-in users who may open /admin/review and the uploaded documents.
REVIEWER_EMAILS=
# SACAA OTP relay. MUST stay false until a legal review of SACAA's terms of use is done (lib/sacaa-otp-relay.ts).
SACAA_OTP_RELAY=false

# Secret for the Vercel Cron call to /api/cron/expiry-reminders (the route returns 503 if unset).
CRON_SECRET=
